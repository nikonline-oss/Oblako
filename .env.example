# Настройки всего проекта. ./project.sh up сам создаст .env из этого файла,
# добавит новые переменные и сгенерирует пустые пароли/ключи.

# ================= Адрес =================
# Как открывают сайты в браузере: localhost на ноутбуке, IP или домен на сервере
PUBLIC_HOST=localhost

# ================= Порты (обязательные) =================
# Впишите порты, выделенные вам на сервере. Проверка: ./deploy/ports.sh
# CRM (ЛР2, ЛР4, ЛР6): http://PUBLIC_HOST:WEB_PORT/nariad/
WEB_PORT=8000
WEB_BIND=0.0.0.0
# WordPress (ЛР7): http://PUBLIC_HOST:WP_PORT/
WP_PORT=8081
WP_BIND=0.0.0.0
# phpMyAdmin (ЛР7). 127.0.0.1 — только с самой машины, 0.0.0.0 — всем
PMA_PORT=8082
PMA_BIND=127.0.0.1

# ================= Порты (необязательные) =================
# Прямой доступ к PostgreSQL и MongoDB снаружи (pgAdmin, Compass и т.п.).
# По умолчанию выключен — порты не занимаются. Включить: COMPOSE_PROFILES=db-ports
COMPOSE_PROFILES=
DB_PORT=5432
DB_BIND=127.0.0.1
MONGO_PORT=27017
MONGO_BIND=127.0.0.1

# Swarm-ферма ЛР3 (./project.sh swarm up): сайт фермы и локальный registry
SWARM_HTTP_PORT=80
REGISTRY_PORT=5000

# Порт gunicorn внутри контейнера CRM (менять не нужно)
APP_PORT=8000

# ================= CRM: PostgreSQL и Django =================
POSTGRES_DB=crm
POSTGRES_USER=crm
# Пустые значения генерируются при первом запуске. Пароль БД потом не менять!
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Адреса сайта CRM через запятую (PUBLIC_HOST добавляется автоматически)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Нужно только для https или работы через прокси, например https://crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Загрузить данные CRM (наряды, сотрудники…) из docker/sqlite_dump.json, если БД пустая
LOAD_INITIAL_DATA=1

# ================= Dropbox (ЛР4) =================
# App key приложения с https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=

# ================= MongoDB (ЛР6) =================
# БД журнала действий CRM
MONGO_DB=crm

# ================= WordPress (ЛР7) =================
MYSQL_DATABASE=wptest
MYSQL_USER=wp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com
WP_TITLE=Сайт студента
# Точка на Яндекс.Карте (страница «Студенту»): долгота,широта
MAP_LL=37.617635,55.755814
