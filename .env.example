# Скопируйте в .env и поменяйте значения под свой сервер

# ---- Порты ----
# Впишите порты, выделенные вам на сервере. Проверить, что они свободны: ./deploy/ports.sh
# Порт сайта снаружи (на сервере обычно 80): http://<ip>:WEB_PORT
WEB_PORT=8000
# На каком интерфейсе открыть сайт (0.0.0.0 — всем, 127.0.0.1 — только локально, например за nginx)
WEB_BIND=0.0.0.0
# Порт gunicorn внутри контейнера (менять обычно не нужно)
APP_PORT=8000
# Порт PostgreSQL снаружи и на каком интерфейсе его открыть
# (127.0.0.1 — только с самого сервера, 0.0.0.0 — всем)
DB_PORT=5432
DB_BIND=127.0.0.1

# ---- PostgreSQL ----
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_password

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# IP/домен сервера через запятую, * — любой
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Нужно только для https или работы через прокси, например https://crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Swarm-ферма ЛР3 (swarm/cluster.sh) ----
# Порт сайта фермы на хосте и порт локального registry
SWARM_HTTP_PORT=80
REGISTRY_PORT=5000

# ---- Dropbox (ЛР4) ----
# App key приложения с https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
# Необязательно: App secret и/или готовый токен вместо подключения из интерфейса
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=
