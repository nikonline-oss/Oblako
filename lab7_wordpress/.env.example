# Скопируйте в .env (./setup.sh сделает это сам и сгенерирует пароли).

# ---- Порты ----
# Сайт WordPress на этой машине
WP_PORT=8081
WP_BIND=0.0.0.0
# phpMyAdmin (по умолчанию только локально; 0.0.0.0 — открыть всем)
PMA_PORT=8082
PMA_BIND=127.0.0.1

# Полный адрес сайта, как его открывают в браузере. Должен совпадать с WP_PORT.
# На сервере: http://IP_СЕРВЕРА:WP_PORT
WP_URL=http://localhost:8081

# ---- MySQL ----
MYSQL_DATABASE=wptest
MYSQL_USER=wp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- Администратор WordPress ----
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com
WP_TITLE=Сайт студента

# ---- Яндекс.Карта на странице «Студенту»: долгота,широта ----
MAP_LL=37.617635,55.755814
